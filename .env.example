# Google Sheets
# Spreadsheet de configuración e histórico (LS_*, RES_*). El dashboard escribe aquí.
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
# Carpeta de Drive con los archivos crudos del día (VTA*, CAR*, REC*, MOV*, KARD*, INV*).
# Si se deja vacía, las hojas RAW_* vuelven a leerse del spreadsheet de arriba.
GOOGLE_DRIVE_RAW_FOLDER_ID=your_drive_folder_id_here
# Opcional: spreadsheet con las hojas LS_* (usuarios, permisos, metas, zonas).
# Requiere permiso de EDITOR para la cuenta de servicio, no solo lector.
# Sin esta variable, las LS_* salen de GOOGLE_SHEETS_ID.
GOOGLE_SHEETS_ID_CONFIG=
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# NextAuth
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3000
